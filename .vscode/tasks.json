{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar Bitacora Campbell",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/scripts/iniciar.ps1\" -SinNavegador",
      "isBackground": true,
      "problemMatcher": {
        "owner": "bitacora",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:.*localhost:5173"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
